# Copy this file to .env and fill in real values. Never commit .env - it is
# already gitignored (see .gitignore). This file documents every variable
# config/environment.js actually reads; keep it in sync when adding new
# ones there.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- CORS (see config/createApp.js) ---
# Only matters for a browser-based consumer (e.g. a Flutter web build) -
# native mobile apps don't send an Origin header and are unaffected. Left
# unset here on purpose: createApp.js stays permissive until both are
# actually configured, so setting them is what locks CORS down.
CLIENT_ORIGIN=
DIETICIAN_ORIGIN=

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/docwellness

# --- Auth ---
JWT_SECRET=CHANGE_ME
JWT_EXPIRE=7d

# --- Supabase (patient/dietician auth) ---
SUPABASE_URL=
# Service role key - full DB access, server-side only. Never ship this to a
# client app (Flutter apps use the public/anon key instead).
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Resend (transactional email) ---
RESEND_API_KEY=
# Defaults to Resend's sandbox sender until docwellness.fit is verified
# (SPF/DKIM/DMARC) in Resend - sandbox can only deliver to the Resend
# account's own verified email.
RESEND_FROM_EMAIL=
# Used for onboarding-style emails that should come from a real person
# rather than a no-reply address. Falls back to RESEND_FROM_EMAIL.
RESEND_FROM_EMAIL_PERSONAL=

# --- OpenAI (AI-assisted recipe/translation/diet-plan generation) ---
OPENAI_API_KEY=
# Pinned explicit snapshots (not bare aliases) so behavior can't silently
# drift when OpenAI repoints an alias to a newer default model.
OPENAI_MODEL_RECIPE=gpt-4o
OPENAI_MODEL_TRANSLATION=gpt-4o-mini
OPENAI_MODEL_DIET_PLAN=gpt-4o

# --- Pexels (stock ingredient images) ---
PEXELS_API_KEY=

# --- Uploads ---
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# --- Realtime chat (see app.js, sockets/chatSocket.js, chat/socket/index.js) ---
# Set to "false" to disable the legacy socket handler once every client is
# confirmed migrated to the v1 socket events (msg.*, conv.*, chat.*,
# presence.*) - defaults to true (both handlers active) otherwise.
LEGACY_SOCKET_COMPAT=true

# --- Misc ---
# Dietician a patient signup gets auto-assigned to when no dietician is
# explicitly chosen.
DEFAULT_DIETICIAN_ID=
SENTRY_DSN=
# Shared secret for /api/internal/* cron-triggered routes (Vercel Cron on
# dev, a VPS crontab entry on prod) instead of normal user JWT auth, since
# these aren't called by an authenticated user.
CRON_SECRET=
