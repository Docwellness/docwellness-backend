{
  "functions": {
    "api/index.js": {
      "maxDuration": 180
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [
    {
      "path": "/api/internal/cron/renewal-reminders",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/cron/goal-nudges",
      "schedule": "30 3 * * *"
    }
  ]
}
