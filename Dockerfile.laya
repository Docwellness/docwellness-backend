# Self-hosted Laya (Jev-compatible /v1/systemone server) for Docwellness.
# Internal-only service: no public domain, no published host port - see
# docs/laya-deployment.md. Build context is this repo; nothing from the
# backend is copied in.
FROM python:3.12-slim

# torch MUST come from the explicit CPU wheel index first. On aarch64 (the
# Oracle ARM VM) a plain `pip install torch` resolves to NVIDIA's CUDA build,
# which is multi-GB and useless on a CPU-only box. Installing the CPU wheel
# first means `laya[serve]` sees torch already satisfied.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir "laya[serve]==0.3.26"

# Coolify's health check shells out to curl/wget, and python:3.12-slim has
# neither; without one the deploy is marked unhealthy and rolled back.
RUN apt-get update && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

# Non-root user; model weights download to HF_HOME on first start, so mount a
# volume there to survive restarts.
RUN useradd --create-home --uid 1000 laya \
 && mkdir -p /models && chown laya:laya /models
USER laya
ENV HF_HOME=/models \
    LAYA_HOST=0.0.0.0 \
    LAYA_PORT=8000 \
    LAYA_DEVICE=cpu \
    LAYA_JEV_STRICT=1
VOLUME /models
EXPOSE 8000

# /health is unauthenticated liveness when LAYA_API_KEY is set. First start
# downloads checkpoints, hence the long start_period.
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8000/health || exit 1

CMD ["laya-serve"]
